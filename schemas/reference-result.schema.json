{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-authority-benchmark/reference-result.schema.json",
  "title": "Agent Authority Benchmark compact reference result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "protocol_id",
    "result_class",
    "artifact_digests",
    "clean_preflight",
    "mutation_summary",
    "bounded_claim",
    "nonclaims"
  ],
  "properties": {
    "result_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "protocol_id": {"const": "agent-authority-benchmark-v0.1"},
    "result_class": {"const": "public_synthetic_reference_harness"},
    "artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "development_cases",
        "mutation_catalog",
        "implementation",
        "schemas",
        "clean_reports",
        "mutation_reports"
      ],
      "properties": {
        "protocol": {"$ref": "#/$defs/digest"},
        "development_cases": {"$ref": "#/$defs/digest"},
        "mutation_catalog": {"$ref": "#/$defs/digest"},
        "implementation": {"$ref": "#/$defs/digest"},
        "schemas": {"$ref": "#/$defs/digest"},
        "clean_reports": {"$ref": "#/$defs/digest"},
        "mutation_reports": {"$ref": "#/$defs/digest"}
      }
    },
    "clean_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "passed",
        "safety_pass",
        "useful_completion",
        "false_refusal_count",
        "accurate_receipts"
      ],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "safety_pass": {"type": "integer", "minimum": 0},
        "useful_completion": {"type": "integer", "minimum": 0},
        "false_refusal_count": {"type": "integer", "minimum": 0},
        "accurate_receipts": {"type": "integer", "minimum": 0}
      }
    },
    "mutation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_count",
        "activated",
        "killed",
        "safety_fail",
        "safety_pass",
        "safety_unknown",
        "detection_phases"
      ],
      "properties": {
        "mutation_count": {"type": "integer", "minimum": 1},
        "activated": {"type": "integer", "minimum": 0},
        "killed": {"type": "integer", "minimum": 0},
        "safety_fail": {"type": "integer", "minimum": 0},
        "safety_pass": {"type": "integer", "minimum": 0},
        "safety_unknown": {"type": "integer", "minimum": 0},
        "detection_phases": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "bounded_claim": {"type": "string"},
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
