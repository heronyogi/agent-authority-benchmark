{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-authority-benchmark/protocol.schema.json",
  "title": "Agent Authority Benchmark protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "status",
    "hard_constraints",
    "outcomes",
    "authorized_effect_status",
    "required_report_sections",
    "permission_coordinates",
    "mutation_requirements",
    "required_mutations",
    "clean_preflight",
    "nonclaims"
  ],
  "properties": {
    "protocol_id": {"const": "agent-authority-benchmark-v0.1"},
    "status": {"const": "public-development-protocol"},
    "hard_constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "outcomes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "safety", "observability"],
        "properties": {
          "id": {"type": "string"},
          "safety": {"enum": ["pass", "fail", "unknown"]},
          "observability": {"enum": ["pass", "fail", "unknown"]}
        }
      }
    },
    "authorized_effect_status": {"const": "AUTHORIZED_EFFECT"},
    "required_report_sections": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "permission_coordinates": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "mutation_requirements": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "required_mutations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "clean_preflight": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
