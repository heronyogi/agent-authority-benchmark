{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-authority-benchmark/case.schema.json",
  "title": "Agent Authority Benchmark development case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "family",
    "variant",
    "utterance",
    "subjects",
    "purpose",
    "emergency",
    "observation_scope",
    "permissions",
    "disputes",
    "candidate_effects",
    "required_useful_effect_ids"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "family": {
      "enum": [
        "present_response",
        "continuity",
        "question",
        "introduction",
        "sensitive_retention"
      ]
    },
    "variant": {"enum": ["restricted", "authorized_positive"]},
    "utterance": {"type": "string", "minLength": 1},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "purpose": {"type": "string", "minLength": 1},
    "emergency": {"type": "boolean"},
    "observation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systems", "propagation_domain", "complete"],
      "properties": {
        "systems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "conversation",
              "memory",
              "recommendation",
              "disclosure",
              "queue",
              "downstream_agent"
            ]
          }
        },
        "propagation_domain": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "complete": {"type": "boolean"}
      }
    },
    "permissions": {
      "type": "array",
      "items": {"$ref": "#/$defs/permission"}
    },
    "disputes": {
      "type": "array",
      "items": {"$ref": "#/$defs/dispute"}
    },
    "candidate_effects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/effect"}
    },
    "required_useful_effect_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "object_ref",
        "effect_kind",
        "purpose",
        "status",
        "requires_receipt",
        "requires_propagation_notice"
      ],
      "properties": {
        "subject": {"type": "string"},
        "object_ref": {"type": "string"},
        "effect_kind": {"$ref": "#/$defs/effectKind"},
        "purpose": {"type": "string"},
        "status": {"enum": ["allowed", "denied", "revoked"]},
        "requires_receipt": {"type": "boolean"},
        "requires_propagation_notice": {"type": "boolean"},
        "retention_days": {"type": ["integer", "null"], "minimum": 1},
        "visibility": {"type": ["string", "null"]}
      }
    },
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "object_ref", "purpose", "active"],
      "properties": {
        "subject": {"type": "string"},
        "object_ref": {"type": "string"},
        "purpose": {"type": "string"},
        "active": {"type": "boolean"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "subject",
        "object_ref",
        "kind",
        "purpose",
        "system",
        "consequential",
        "useful",
        "emergency_claimed",
        "payload"
      ],
      "properties": {
        "effect_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "subject": {"type": "string"},
        "object_ref": {"type": "string"},
        "kind": {"$ref": "#/$defs/effectKind"},
        "purpose": {"type": "string"},
        "system": {
          "enum": [
            "conversation",
            "memory",
            "recommendation",
            "disclosure",
            "queue",
            "downstream_agent"
          ]
        },
        "consequential": {"type": "boolean"},
        "useful": {"type": "boolean"},
        "emergency_claimed": {"type": "boolean"},
        "payload": {"type": "string"}
      }
    },
    "effectKind": {
      "enum": [
        "respond",
        "ask",
        "compare",
        "memory_write",
        "recommend",
        "disclose",
        "queue_action",
        "downstream_message"
      ]
    }
  }
}
